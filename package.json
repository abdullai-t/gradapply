{
  "name": "gradapply",
  "version": "1.9.1",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "build:cf": "prisma generate && CF_BUILD=1 next build",
    "cf:build": "node scripts/run-with-cf-env.mjs pnpm run cf:build:inner",
    "cf:build:inner": "pnpm run build:cf && opennextjs-cloudflare build --skipNextBuild && node scripts/prune-cf-worker-bundle.mjs",
    "cf:deploy": "node scripts/run-with-cf-env.mjs pnpm run cf:deploy:inner",
    "cf:deploy:inner": "node scripts/prepare-wrangler-hyperdrive.mjs && pnpm run cf:build:inner && pnpm exec wrangler deploy",
    "cf:tail": "wrangler tail mygradapply --format pretty",
    "cf:tail:app": "wrangler tail mygradapply --format pretty --search gradapply",
    "cf:tail:errors": "wrangler tail mygradapply --format pretty --search error",
    "start": "next start",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration --exclude '**/*.db.test.ts'",
    "test:integration:db": "vitest run --config vitest.config.db.ts",
    "test:db:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:db:down": "docker compose -f docker-compose.test.yml down -v",
    "test:integration:db:local": "pnpm run test:db:up && DATABASE_URL_TEST=postgresql://postgres:pass@localhost:5433/gradapply_test pnpm run test:integration:db",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "test:e2e:smoke": "playwright test --config tests/e2e/playwright.config.ts tests/e2e/smoke",
    "test:e2e:staging": "playwright test --config tests/e2e/playwright.config.ts tests/e2e/staging",
    "test:seed-e2e": "tsx tests/scripts/seed-e2e.ts",
    "mail:test": "tsx scripts/test-email.ts",
    "postinstall": "prisma generate",
    "version:sync": "node scripts/sync-version-from-build.mjs",
    "version:verify": "node scripts/verify-build-version.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@hookform/resolvers": "^3.9.1",
    "@prisma/adapter-pg": "5.22.0",
    "@prisma/client": "5.22.0",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-progress": "^1.1.1",
    "@radix-ui/react-scroll-area": "^1.2.2",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.2",
    "@sentry/nextjs": "^10.49.0",
    "@tanstack/react-query": "^5.100.5",
    "@tanstack/react-query-devtools": "^5.100.5",
    "@tiptap/core": "2",
    "@tiptap/extension-bubble-menu": "2",
    "@tiptap/extension-placeholder": "2",
    "@tiptap/pm": "2",
    "@tiptap/react": "2",
    "@tiptap/starter-kit": "2",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.37.0",
    "ai": "^6.0.182",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.9.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "diff": "^9.0.0",
    "firebase": "^12.14.0",
    "firebase-admin": "^13.10.0",
    "ioredis": "^5.10.1",
    "jose": "^6.2.3",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.12.0",
    "next": "16.2.6",
    "nodemailer": "^7.0.7",
    "openai": "^4.104.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.20.0",
    "pg-cloudflare": "^1.3.0",
    "posthog-js": "^1.376.4",
    "posthog-node": "^5.35.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.54.2",
    "react-markdown": "9",
    "remark-gfm": "4",
    "resend": "^6.12.4",
    "sanitize-html": "^2.17.4",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "xlsx": "^0.18.5",
    "zod": "^3.24.1"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "16.2.6",
    "@opennextjs/cloudflare": "^1.19.9",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.20.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/sanitize-html": "^2.16.1",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "3.2.4",
    "eslint": "^9.34.0",
    "eslint-config-next": "16.2.6",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "msw": "^2.14.6",
    "postcss": "^8",
    "prisma": "5.22.0",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vite": "5.4.21",
    "vitest": "^3.2.4",
    "wrangler": "^4.86.0"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.14",
      "@types/react-dom": "19.2.3"
    }
  }
}
