{
  "name": "gradapply-monorepo",
  "version": "0.1.1",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @gradapply/frontend dev",
    "dev:frontend": "pnpm --filter @gradapply/frontend dev",
    "dev:backend": "pnpm --filter @gradapply/backend dev",
    "dev:all": "pnpm run --parallel dev:frontend dev:backend",
    "build": "pnpm --filter @gradapply/frontend build",
    "start": "pnpm --filter @gradapply/frontend start",
    "lint": "pnpm --filter @gradapply/frontend lint",
    "typecheck": "pnpm --filter @gradapply/frontend typecheck",
    "predeploy": "pnpm --filter @gradapply/frontend predeploy",
    "db:backfill:pricing-rollout": "pnpm --filter @gradapply/frontend db:backfill:pricing-rollout",
    "ops:release-check": "pnpm run lint && pnpm run typecheck",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7"
  }
}
