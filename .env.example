# Copy to .env and fill in values. Never commit .env.
# See DEPLOY.md for production (Vercel) setup.

# --- Required for local app + Prisma ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?schema=public"
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
# Production (Cloudflare / custom domain): set to your public origin, e.g. https://mygradapply.com
NEXTAUTH_URL="http://localhost:3000"

# --- OAuth (optional) ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- AI (set at least one provider in production) ---
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# AI_PROVIDER=

# --- Billing (optional) ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# PAYSTACK_SECRET_KEY=

# --- Distributed rate limits (recommended for public prod) ---
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- Observability ---
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=

# --- Product / UX ---
# NEXT_PUBLIC_SUPPORT_EMAIL=

# --- Feature flags (optional env overrides; DB flags in admin) ---
# FEATURE_FLAG_USER_SETTINGS_PAGE=
# FEATURE_FLAG_HOMEPAGE_PRICING_SECTION=

# --- Email (magic link / SMTP — optional) ---
# SMTP_* or provider vars your host documents
