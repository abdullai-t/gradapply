# Copy to .env and fill in values. Never commit .env.
# See DEPLOY.md for production (Vercel) setup.

# --- Required for local app + Prisma ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?schema=public"
# Encrypts admin AppSetting secrets (not Firebase sessions)
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
# Production (Cloudflare / custom domain): set to your public origin, e.g. https://mygradapply.com
NEXTAUTH_URL="http://localhost:3000"

# Cloudflare Hyperdrive (production Workers DB). Binding id is in wrangler.jsonc.
# Wrangler 4 needs this locally when running cf:build / cf:deploy (auto-set from DATABASE_URL).
# If local Postgres has no password (postgresql://user@localhost/...), run-with-cf-env.mjs adds an empty password for Miniflare.
# CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=
# HYPERDRIVE_CONFIG_ID=5956745febb74a23b28169b36595d55c

# --- Firebase Auth (required) ---
# Create a Firebase project → Project settings → Your apps (Web) for client keys.
# Authentication → Sign-in method: enable Google, Email link (passwordless), and Email/Password (admins only).
# Add authorized domains: localhost, your production domain.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional client keys:
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# Web push (FCM) — Firebase Console → Project settings → Cloud Messaging → Web Push certificates
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_VAPID_KEY=
# Server: Firebase Console → Project settings → Service accounts → Generate new private key
# Must be ONE line in .env (not pretty-printed JSON). Helper:
#   pnpm run format:firebase-sa -- --write-env ~/Downloads/your-firebase-key.json
#   pnpm run verify:firebase-sa
# Or paste JSON as one line, or use discrete vars:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- AI (OpenRouter and/or Groq — see AI_PROVIDER in src/lib/llm-provider.ts) ---
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# AI_PROVIDER=
# PAYSTACK_SECRET_KEY=

# --- Distributed rate limits (recommended for public prod) ---
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- Observability ---
# LOG_LEVEL=debug
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_ORG_SLUG=
# SENTRY_PROJECT=

# Admin analytics — Cloudflare Workers (production on CF)
# CLOUDFLARE_ACCOUNT_ID=b90b26056234066a56d0a0f03a0c777c
# CLOUDFLARE_API_TOKEN=  # Custom token: Account → Account Analytics → Read (NOT deploy-only tokens)
# Account Resources: include this account (or All accounts)
# CLOUDFLARE_WORKER_NAME=mygradapply
# NEON_CONSOLE_URL=https://console.neon.tech/...

# PostHog (optional product analytics)
# NEXT_PUBLIC_POSTHOG_KEY=
# Client SDK is OFF in development unless:
# NEXT_PUBLIC_POSTHOG_DEV=true
# Force off everywhere:
# NEXT_PUBLIC_POSTHOG_DISABLED=true
# Direct API (skip /ingest proxy — use on Cloudflare Workers):
# NEXT_PUBLIC_POSTHOG_USE_PROXY=false
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# NEXT_PUBLIC_POSTHOG_PROJECT_ID=
# NEXT_PUBLIC_POSTHOG_DEBUG=true

# --- Product / UX ---
# NEXT_PUBLIC_SUPPORT_EMAIL=

# --- Feature flags (optional env overrides; DB flags in admin) ---
# FEATURE_FLAG_USER_SETTINGS_PAGE=
# FEATURE_FLAG_HOMEPAGE_PRICING_SECTION=
# FEATURE_FLAG_COLLABORATION=true

# --- Google Docs sync (requires Drive connector + public webhook URL) ---
# Cron renews Drive push channels: GET /api/cron/google-docs with Bearer $CRON_SECRET
# Webhook: {APP_ORIGIN}/api/webhooks/google-drive (must be HTTPS in production)

# --- Admin bootstrap (production first superadmin) ---
# ALLOW_SUPERADMIN_BOOTSTRAP=true
# SUPERADMIN_EMAILS=you@example.com

# --- Scholar collaboration (review sessions + optional Liveblocks live edit) ---
# COLLAB_TOKEN_PEPPER=  # optional; defaults to AUTH_SECRET for guest link hashing
# LIVEBLOCKS_SECRET_KEY=
# NEXT_PUBLIC_LIVEBLOCKS_PUBLIC_KEY=

# --- Email (transactional + magic link) ---
# Resend (recommended): app mail uses HTTPS API; magic links may use SMTP on port 465
# RESEND_API_KEY=re_...
# EMAIL_FROM="GradApply <hello@your-verified-domain.com>"
# RESEND_SMTP_PORT=465
# RESEND_SMTP_SECURE=true
# Or generic SMTP: SMTP_HOST, SMTP_USER, SMTP_PASSWORD, SMTP_PORT
# Or: EMAIL_SERVER=...
# Dev inbox: MAIL_DEV_ETHEREAL=true