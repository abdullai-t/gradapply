# Database (PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Required for cookies / sessions (generate: openssl rand -base64 32)
AUTH_SECRET=""
# After `pnpm db:seed`, local test sign-in (email + password):
#   test@gradapply.local / password123
# Local dev (optional; trustHost is enabled)
AUTH_URL="http://localhost:3000"
# Legacy alias — same value as AUTH_SECRET if you use it
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# Google OAuth — create OAuth client (Web application) in Google Cloud Console.
# Authorized redirect URI must include exactly:
#   http://localhost:3000/api/auth/callback/google
# (Add your production URL there when you deploy.)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# SMTP / Email magic links use nodemailer — not bundled in Edge middleware here.
# Run a dedicated Node auth route or extend auth.ts on a Node-only deployment if needed.
EMAIL_SERVER=""
EMAIL_FROM="GradApply <noreply@yourdomain.com>"

# LLM — set OpenRouter, Anthropic, and/or OpenAI (see https://openrouter.ai/docs/quickstart ).
# Default when multiple keys exist: OpenAI wins if OPENAI_API_KEY is set; otherwise OpenRouter beats Anthropic.
# AI_PROVIDER="anthropic" | "openrouter" | "openai" forces a backend when keys overlap.

# OpenRouter (unified API — works with OpenAI-compatible client; uses Anthropic/OpenAI/etc. models by slug)
OPENROUTER_API_KEY=""
# Example model slug; override to any model listed on openrouter.ai/models
# OPENROUTER_MODEL="anthropic/claude-sonnet-4"
# Optional attribution headers for OpenRouter rankings (recommended in production):
# OPENROUTER_SITE_URL="https://your-site.example"
# OPENROUTER_SITE_TITLE="GradApply"

# Anthropic (direct Claude API — alternative to OpenRouter)
ANTHROPIC_API_KEY=""
# Optional override; default: claude-sonnet-4-20250514
# ANTHROPIC_MODEL="claude-sonnet-4-20250514"

# Document uploads — prefer Cloudinary (recommended). Falls back to S3 when unset.
# Option A — single URL (restart dev server after changing):
# CLOUDINARY_URL="cloudinary://API_KEY:API_SECRET@CLOUD_NAME"
CLOUDINARY_URL=""
# Option B — split (same credentials; use if CLOUDINARY_URL is unreliable in your shell):
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""

# S3 or Cloudflare R2 (S3-compatible)
AWS_REGION="auto"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_BUCKET=""
# Public URL prefix for uploaded objects (R2 custom domain or S3 HTTPS URL base)
PUBLIC_OBJECT_BASE_URL=""
# Optional: custom endpoint for R2 / MinIO
S3_ENDPOINT=""

# OpenAI (direct API) — used for multi-agent assistant routing (e.g. fast grammar on gpt-4o-mini) and as a fallback when Anthropic/OpenRouter are unset.
OPENAI_API_KEY=""
# Default model for quality tasks when provider is OpenAI (SOP, email, feedback, general).
# OPENAI_MODEL="gpt-4o"
# Lighter model for the grammar agent (when OPENAI_API_KEY is set).
# OPENAI_MODEL_GRAMMAR="gpt-4o-mini"