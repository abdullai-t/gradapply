# Copy to .env and fill in values. Never commit .env.
# See DEPLOY.md for production (Vercel) setup.

# --- Required for local app + Prisma (MongoDB via packages/db) ---
MONGODB_URI="mongodb://USER:PASSWORD@HOST:27017/DATABASE?retryWrites=true&w=majority"
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# --- OAuth (optional) ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Route AI / heavy APIs through Express (recommended) ---
# Put ALL LLM API keys only in `backend/.env` (GEMINI_API_KEY, OPENAI_API_KEY, …).
# Start the API: `pnpm --filter @gradapply/backend dev` (default :8080).
# Then proxy selected `/api/*` routes from Next to that server (same-origin cookies):
# BACKEND_PROXY_URL=http://localhost:8080
#
# Alternative for static hosting / cross-origin API host (needs CORS + auth strategy):
# NEXT_PUBLIC_API_URL=http://localhost:8080
#
# Do not put provider secrets in NEXT_PUBLIC_* vars — they are exposed to the browser.

# --- Billing (optional) ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# PAYSTACK_SECRET_KEY=

# --- Distributed rate limits (recommended for public prod) ---
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- Observability ---
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=

# --- Product / UX ---
# NEXT_PUBLIC_SUPPORT_EMAIL=

# --- Feature flags (optional env overrides; DB flags in admin) ---
# FEATURE_FLAG_USER_SETTINGS_PAGE=
# FEATURE_FLAG_HOMEPAGE_PRICING_SECTION=

# --- Email (magic link / SMTP — optional) ---
# SMTP_* or provider vars your host documents

# --- Backend-only duplicates (usually unnecessary if BACKEND_PROXY_URL is set) ---
# PORT=8080
# MONGODB_URI=mongodb://localhost:27017/gradapply
# CORS_ORIGIN=http://localhost:3000
