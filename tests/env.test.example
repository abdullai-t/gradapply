# Copy to .env.test (gitignored) for local integration / E2E runs.
NODE_ENV=test
AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Vitest handler tests (mocked Prisma — optional)
PAYSTACK_SECRET_KEY=sk_test_dummy
PAYSTACK_WEBHOOK_SECRET=whsec_dummy
OPENROUTER_API_KEY=sk-or-test-dummy
GROQ_API_KEY=gsk_test_dummy

# Real Postgres for *.db.test.ts (isolated — never use production DATABASE_URL)
# Recommended: pnpm run test:db:up  (Docker on port 5433)
DATABASE_URL_TEST=postgresql://postgres:pass@localhost:5433/gradapply_test
# Homebrew Postgres instead of Docker:
# DATABASE_URL_TEST=postgresql://YOUR_MAC_USER@localhost:5432/gradapply_test

# E2E smoke (CI sets these when starting the app)
ALLOW_E2E_FIXTURES=1
E2E_FREE_USER_ID=e2e-free-user
E2E_PLUS_USER_ID=e2e-plus-user

# Staging nightly Playwright (workflow secrets)
STAGING_URL=https://staging.mygradapply.com
STAGING_TEST_EMAIL=
STAGING_TEST_PASSWORD=
