{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "mygradapply",
    "main": ".open-next/worker.js",
    "compatibility_date": "2026-05-14",
    "observability": {
        "enabled": true,
        "logs": {
            "enabled": true,
            "persist": true,
            "invocation_logs": true,
            "destinations": ["grafana-logs"]
        }, 
        "traces": {
            "enabled": true,
            "destinations": ["grafana-traces"]
        }
    },
    "compatibility_flags": [
        "nodejs_compat"
    ],
    "assets": {
        "directory": ".open-next/assets"
    },
    "services": [
        {
            "binding": "WORKER_SELF_REFERENCE",
            "service": "mygradapply"
        }
    ],
    "routes": [
        {
            "pattern": "mygradapply.com",
            "custom_domain": true
        },
        {
            "pattern": "www.mygradapply.com",
            "custom_domain": true
        }
]
}