{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "mygradapply",
    "main": ".open-next/worker.js",
    "compatibility_date": "2026-05-14",
    "observability": {
        "enabled": true
    },
    "compatibility_flags": [
        "nodejs_compat"
    ],
    "assets": {
        "directory": ".open-next/assets"
    },
    "services": [
        {
            "binding": "WORKER_SELF_REFERENCE",
            "service": "mygradapply"
        }
    ]
}