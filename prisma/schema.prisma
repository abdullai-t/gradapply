generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlanTier {
  FREE
  PLUS
  PRO
}

enum UserRole {
  USER
  ADMIN
  SUPERADMIN
}

enum AccountAccessMode {
  FULL
  READ_ONLY
}

enum BillingProvider {
  STRIPE
  PAYSTACK
}

enum BillingPaymentKind {
  PLAN_PURCHASE
  CREDITS_PACK
  CV_DEEP_REVIEW
  SOP_DETAILED_CRITIQUE
}

/// Dedupe Stripe webhook deliveries (same event id must not apply twice).
model StripeEventLog {
  eventId   String   @id
  createdAt DateTime @default(now())
}

/// Dedupe Paystack fulfillment (callback + webhook) per transaction reference.
model PaystackEventLog {
  reference String   @id
  createdAt DateTime @default(now())
}

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  enabled     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AppSetting {
  key       String   @id
  value     String   @db.Text
  isSecret  Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  emailVerified DateTime?
  name          String?
  image         String?
  /// bcrypt hash for email/password sign-in; null for OAuth-only users
  passwordHash  String?
  createdAt     DateTime  @default(now())
  role          UserRole  @default(USER)

  /// Subscription & AI allowance. Enforced when Stripe and/or Paystack keys are set (see billing-config).
  planTier             PlanTier @default(FREE)
  stripeCustomerId     String?  @unique
  stripeSubscriptionId String?
  stripePriceId        String?
  subscriptionStatus   String?
  currentPeriodEnd     DateTime?
  /// Paystack customer id (numeric string from API) and subscription code for renewals / portal.
  paystackCustomerId       String? @unique
  paystackSubscriptionCode String?
  /// Successful AI actions counted against monthly tier allowance this billing period.
  aiUsageUsed          Int      @default(0)
  /// Bonus credits from one-time packs; consumed before monthly allowance.
  aiCreditsBalance     Int      @default(0)
  /// ISO month token (`YYYY-MM`) for monthly credit usage reset.
  aiUsageMonth         String?
  /// Free-plan lifetime cold email generations consumed.
  freeEmailGenUsed     Int      @default(0)
  /// Free-plan lifetime SOP previews consumed.
  freeSopPreviewUsed   Int      @default(0)
  /// Account access mode; expired subscriptions become READ_ONLY.
  accessMode           AccountAccessMode @default(FULL)
  /// Optional date the subscription most recently expired.
  accessReadOnlySince  DateTime?

  accounts      Account[]
  sessions      Session[]
  profile       Profile?
  schools       School[]
  emails        ProfEmail[]
  chatMessages  ChatMessage[]
  documents       Document[]
  folders         Folder[]
  connectors      Connector[]
  contentVersions ContentVersion[]
  sopVariants     SopVariant[]
  billingPayments BillingPayment[]
}

model BillingPayment {
  id                String             @id @default(cuid())
  userId             String
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider           BillingProvider
  providerReference  String
  kind               BillingPaymentKind
  tier               PlanTier?
  amountMinor        Int?
  currency           String?
  paidAt             DateTime
  createdAt          DateTime           @default(now())

  @@unique([provider, providerReference])
  @@index([userId, paidAt])
}

enum ContentEntityType {
  SOP
  CV
  PROF_EMAIL
  OTHER
}

/// Named snapshots for drafts (email text, SOP text, or file URL pointers).
model ContentVersion {
  id              String             @id @default(cuid())
  userId          String
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  entityType      ContentEntityType
  entityId        String?
  label           String
  /// Plain text, or JSON for PROF_EMAIL: {"emailSubject":"...","emailBody":"..."}
  body            String?            @db.Text
  fileUrl         String?
  createdAt       DateTime           @default(now())
  parentVersionId String?
  parentVersion   ContentVersion?    @relation("ContentVersionChain", fields: [parentVersionId], references: [id], onDelete: SetNull)
  childVersions   ContentVersion[]   @relation("ContentVersionChain")

  @@index([userId, entityType, entityId])
}

/// Per-user OAuth links to Google (row per user + provider). Refresh tokens are never shared across users.
model Connector {
  id              String            @id @default(cuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider        ConnectorProvider
  /// Linked Google account email shown in UI (Gmail profile or OAuth userinfo).
  externalEmail   String?
  refreshToken    String            @db.Text
  accessToken     String?           @db.Text
  accessExpiresAt DateTime?
  scopes          String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([userId, provider])
}

enum ConnectorProvider {
  GMAIL
  GOOGLE_DRIVE
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Profile {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetDegree      String?
  focusArea         String?
  greScore          String?
  greVerbal         Int?
  greQuant          Int?
  greAWA            Float?
  undergradSchool   String?
  undergradDegree   String?
  undergradGPA      Float?
  yearsExperience   String?
  researchInterests String?
  countriesOfInterest String[] @default([])
  bio               String?
  updatedAt         DateTime @updatedAt
}

model School {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  program   String
  degree    String
  country   String?
  /// Intake term (e.g. Fall 2026)
  term      AdmissionTerm?
  deadline  DateTime?
  status    SchoolStatus   @default(PLANNING)
  funding   String?
  notes     String?
  portalUrl String?
  progress  Int            @default(0)
  /// Optional nudge before/on the application deadline (email-style reminder in data model only).
  reminderAt   DateTime?
  reminderNote String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  sopVariant   SopVariant?
  chatMessages ChatMessage[]

  @@index([userId, updatedAt])
  @@index([userId, deadline])
  @@index([userId, reminderAt])
  @@index([userId, status, deadline])
}

enum SchoolStatus {
  PLANNING
  APPLIED
  WAITING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum AdmissionTerm {
  FALL
  SPRING
  SUMMER
}

model ProfEmail {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Filled by AI from the profile URL when possible; user can edit.
  profName      String?
  profEmail     String?
  university    String?
  /// Faculty profile / lab / directory page — primary input for AI extraction + drafting
  profileUrl    String?
  researchArea  String?
  emailSubject  String?
  emailBody     String?
  status        EmailStatus @default(DRAFT)
  sentAt       DateTime?
  repliedAt    DateTime?
  /// Latest pasted or synced excerpt of the professor's reply (replaces legacy replySnippet).
  lastReplySnippet String?
  replyIntent               ReplyIntent?
  suggestedReplyDraft       String?    @db.Text
  replyRationale            String?    @db.Text
  lastClassifiedAt DateTime?
  followUpCount Int         @default(0)
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([userId, updatedAt])
  @@index([userId, status, updatedAt])
}

enum EmailStatus {
  DRAFT
  SENT
  REPLIED
  NO_REPLY
  NOT_INTERESTED
}

enum ReplyIntent {
  INTERESTED
  NEUTRAL
  DECLINED
  UNKNOWN
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String
  content   String   @db.Text
  mode      String?
  /// Scopes SOP-mode chats per school so per-school histories don't bleed.
  /// Null for general/non-school-scoped chats.
  schoolId  String?
  school    School?  @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([userId, mode, schoolId, createdAt])
  @@index([userId, mode, createdAt])
  @@index([userId, createdAt])
}

model Document {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  type      String
  url       String
  s3Key     String?
  mimeType  String?
  size      Int?
  /// Optional user-defined folder. Null = "uncategorized" (lives in Category card buckets only).
  folderId  String?
  folder    Folder?  @relation(fields: [folderId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, folderId])
}

/// User-defined document folder. Soft-cap of 50 folders per user enforced in the API layer.
model Folder {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  /// Optional Material Symbol icon name (e.g. "folder", "school", "history_edu"). Defaults to "folder" in the UI.
  icon      String?
  /// Optional accent color token (e.g. "primary", "tertiary", "error"). Defaults to "primary" in the UI.
  color     String?
  documents Document[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([userId, name])
  @@index([userId, createdAt])
}

/// Per-school tailored SOP derived from a master draft (uploaded `sop_draft` or pasted text).
model SopVariant {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolId       String   @unique
  school         School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  title          String
  body           String   @db.Text
  /// Master `Document.id` when the draft came from the library (`sop_draft`); null when pasted only.
  sourceMasterId String?
  /// Persisted master text — pasted, uploaded, or extracted from the source doc.
  /// Lets returning users skip onboarding and keeps "View original" working without re-reading the doc.
  masterText     String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
}
