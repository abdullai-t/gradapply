# Copy to `.env` for local runs. Never commit `.env`.

PORT=8080
MONGODB_URI="mongodb://127.0.0.1:27017/gradapply"
CORS_ORIGIN=http://localhost:3000

# Same signing secret as Next.js / Auth.js (JWT validation on proxied `/api` requests)
AUTH_SECRET="replace-with-openssl-rand-base64-32"
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# --- AI / LLM (keep here when Next uses BACKEND_PROXY_URL or NEXT_PUBLIC_API_URL) ---
# AI_PROVIDER=gemini
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=

# --- Vercel AI Gateway (AI SDK `@ai-sdk/openai` base URL + key) ---
# VERCEL_AI_GATEWAY_URL=https://ai-gateway.vercel.sh/v1
# VERCEL_AI_GATEWAY_KEY=
# Optional per-feature overrides (full provider/model id from the gateway catalog):
# AI_MODEL_DEADLINE_EXTRACT=
# AI_MODEL_STATUS_CLASSIFY=
# AI_MODEL_PROFILE_FIT=
# AI_MODEL_PROGRAM_SEARCH=
# AI_MODEL_PROFESSOR_LOOKUP=
# AI_MODEL_COLD_EMAIL=
# AI_MODEL_SOP_REVIEW=

# --- Cache (Upstash REST — optional; AI routes degrade when unset) ---
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- BullMQ SOP review worker (required for async gateway SOP review) ---
# REDIS_URL=redis://127.0.0.1:6379
